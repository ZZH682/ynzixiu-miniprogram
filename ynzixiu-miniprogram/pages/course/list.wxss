@import "/templates/course.wxss";

.sticky { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 20rpx 0 24rpx; }
.search {
  margin: 0 32rpx 20rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.search-input { flex: 1; font-size: 28rpx; }
.search-clear { font-size: 24rpx; color: var(--text-3); margin-left: 16rpx; }
.list { margin: 0 32rpx 40rpx; padding-top: 8rpx; padding-bottom: 8rpx; }
