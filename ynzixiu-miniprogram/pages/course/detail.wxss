.hero, .player { height: 420rpx; position: relative; overflow: hidden; }
.hero { display: flex; flex-direction: column; justify-content: flex-end; padding: 40rpx 32rpx; }
.hero-char { position: absolute; right: -24rpx; bottom: -80rpx; font-size: 400rpx; font-weight: 800; opacity: 0.14; line-height: 1; }
.hero-type { font-size: 24rpx; font-weight: 600; letter-spacing: 2rpx; position: relative; }
.hero-name { font-size: 56rpx; font-weight: 800; margin-top: 8rpx; position: relative; }

.player { background: #0B1322; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 48rpx; }
.player-play { width: 112rpx; height: 112rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.14); display: flex; align-items: center; justify-content: center; }
.tri { width: 0; height: 0; border-left: 34rpx solid #fff; border-top: 22rpx solid transparent; border-bottom: 22rpx solid transparent; margin-left: 10rpx; }
.player-title { margin-top: 28rpx; font-size: 28rpx; font-weight: 600; text-align: center; }
.player-note { margin-top: 8rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.5); text-align: center; }
.player-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background: rgba(255, 255, 255, 0.15); }
.player-bar-in { width: 18%; height: 100%; background: var(--brand); }

.info { background: var(--card); padding: 32rpx; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 700; line-height: 1.4; }
.sub { margin-top: 10rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.6; }
.price-row { display: flex; align-items: baseline; margin-top: 24rpx; }
.price.big { font-size: 48rpx; }
.sales { margin-left: auto; font-size: 23rpx; color: var(--text-3); }
.progress { margin-top: 24rpx; }
.progress-text { font-size: 24rpx; color: var(--good); margin-bottom: 10rpx; }
.progress-bar { height: 10rpx; border-radius: 10rpx; background: var(--line); overflow: hidden; }
.progress-in { height: 100%; background: var(--good); border-radius: 10rpx; }

.teacher { margin: 0 32rpx 20rpx; display: flex; align-items: center; padding: 24rpx 32rpx; }
.teacher-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 30rpx; margin-right: 20rpx; }
.teacher-name { font-size: 28rpx; font-weight: 600; }
.teacher-note { font-size: 23rpx; color: var(--text-3); margin-top: 2rpx; }

.tabs { display: flex; padding: 0 32rpx; margin-bottom: 16rpx; }
.tab { margin-right: 40rpx; padding: 16rpx 0; font-size: 29rpx; color: var(--text-3); position: relative; }
.tab.on { color: var(--ink); font-weight: 600; }
.tab.on::after { content: ''; position: absolute; left: 0; right: 0; bottom: 4rpx; height: 6rpx; border-radius: 6rpx; background: var(--brand); }

.panel { margin: 0 32rpx; }
.hl { display: flex; align-items: flex-start; font-size: 28rpx; padding: 12rpx 0; line-height: 1.6; }
.hl-no { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 10rpx; background: var(--brand-weak); color: var(--brand); font-size: 22rpx; font-weight: 700; margin-right: 18rpx; margin-top: 4rpx; flex-shrink: 0; }
.panel-note { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); font-size: 23rpx; color: var(--text-3); line-height: 1.6; }

.chapter { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.chapter:last-child { border-bottom: none; }
.chapter.now .chapter-title { color: var(--brand); font-weight: 600; }
.chapter-no { width: 56rpx; font-size: 26rpx; color: var(--text-3); font-weight: 600; }
.chapter-main { flex: 1; min-width: 0; margin-right: 16rpx; }
.chapter-title { font-size: 28rpx; }
.chapter-dur { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.chapter-lock { font-size: 22rpx; color: var(--text-3); }
.chapter .tag { margin-right: 0; }

.bar-icon { width: 96rpx; display: flex; flex-direction: column; align-items: center; font-size: 22rpx; color: var(--text-2); margin-right: 16rpx; }
.bar-icon-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: 4rpx solid var(--text-2); margin-bottom: 4rpx; position: relative; }
.bar-icon-dot::after { content: ''; position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--text-2); left: 9rpx; top: 9rpx; }
.bar-main { flex: 1; }
