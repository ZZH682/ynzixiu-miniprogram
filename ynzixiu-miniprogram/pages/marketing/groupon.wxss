.group { margin-bottom: 20rpx; }
.group-head { display: flex; }
.group-cover {
  width: 96rpx; height: 96rpx; border-radius: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 800;
}
.group-main { flex: 1; min-width: 0; margin-left: 22rpx; }
.group-title { font-size: 29rpx; font-weight: 600; line-height: 1.45; }
.group-price { margin-top: 12rpx; display: flex; align-items: baseline; }
.price.big { font-size: 36rpx; }
.group-save { margin-left: 14rpx; font-size: 22rpx; color: var(--good); background: var(--good-weak); border-radius: 8rpx; padding: 2rpx 10rpx; }

.group-progress { margin-top: 22rpx; }
.group-progress-text { font-size: 23rpx; color: var(--text-2); }
.progress-bar {
  margin-top: 12rpx; height: 12rpx; border-radius: 999rpx;
  background: var(--bg); overflow: hidden;
}
.progress-in { height: 100%; border-radius: 999rpx; background: var(--brand); }

.group-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.group-leader { font-size: 23rpx; color: var(--text-3); }
.group-btn { width: 200rpx; height: 68rpx; line-height: 68rpx; font-size: 27rpx; }

.team-list { padding-top: 8rpx; padding-bottom: 8rpx; }
.team { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.team:last-child { border-bottom: none; }
.team-main { flex: 1; min-width: 0; }
.team-name { font-size: 28rpx; font-weight: 600; }
.team-meta { margin-top: 8rpx; font-size: 23rpx; color: var(--text-3); }
.team-side { display: flex; align-items: center; }
.team-side .tag { margin-right: 14rpx; }
.team-share { font-size: 27rpx; color: var(--brand); font-weight: 600; padding: 8rpx 20rpx; border: 2rpx solid var(--brand); border-radius: 999rpx; }

.tip { margin: 0 32rpx 20rpx; }
.tip-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.tip-text { font-size: 25rpx; color: var(--text-2); line-height: 1.8; }
