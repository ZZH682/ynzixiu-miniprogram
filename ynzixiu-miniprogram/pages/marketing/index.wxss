.hero {
  background: var(--ink);
  color: #fff;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
}
.hero-title { display: block; font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.hero-sub { display: block; margin-top: 14rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.6); }

.menu { margin: 0 32rpx 20rpx; padding-top: 8rpx; padding-bottom: 8rpx; }
.menu-icon {
  width: 84rpx; height: 84rpx; border-radius: 22rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; font-weight: 700; margin-right: 22rpx;
}
.menu-name { font-size: 30rpx; font-weight: 600; }
.menu-desc { margin-top: 8rpx; font-size: 24rpx; color: var(--text-3); line-height: 1.5; }

.tip { margin: 0 32rpx 20rpx; }
.tip-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.tip-text { font-size: 25rpx; color: var(--text-2); line-height: 1.8; }
