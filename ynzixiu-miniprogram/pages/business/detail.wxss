@import "/templates/course.wxss";

.head { position: relative; overflow: hidden; padding: 48rpx 32rpx 44rpx; margin-bottom: 32rpx; }
.head-char { position: absolute; right: -20rpx; top: -40rpx; font-size: 280rpx; font-weight: 800; opacity: 0.12; line-height: 1; }
.head-name { font-size: 44rpx; font-weight: 700; position: relative; }
.head-summary { margin-top: 8rpx; font-size: 27rpx; color: var(--text-2); position: relative; }
.head-tags { margin-top: 24rpx; position: relative; }
.head-tag { background: rgba(255, 255, 255, 0.7); }

.block-label { font-size: 24rpx; color: var(--text-3); letter-spacing: 2rpx; }
.block-label.gap { margin-top: 28rpx; }
.block-text { margin-top: 8rpx; font-size: 28rpx; line-height: 1.7; }
.offers { margin-top: 20rpx; display: flex; flex-wrap: wrap; }
.offer { width: 50%; display: flex; align-items: center; font-size: 26rpx; padding: 10rpx 0; }
.offer-dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 14rpx; flex-shrink: 0; }

.list-card { padding-top: 8rpx; padding-bottom: 8rpx; }
.news-title { font-size: 28rpx; }
.news-meta { margin-top: 6rpx; font-size: 22rpx; color: var(--text-3); }

.story-result { font-size: 30rpx; font-weight: 700; }
.story-quote { margin-top: 12rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.6; }
.story-who { margin-top: 16rpx; font-size: 22rpx; color: var(--text-3); }

.bar-call { width: 220rpx; margin-right: 20rpx; }
.bar-main { flex: 1; }
