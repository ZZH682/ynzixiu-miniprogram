<view class="page">
  <view wx:if="{{liveNow}}" class="section">
    <view class="section-head">
      <text class="section-title">正在直播</text>
      <text class="section-more">{{liveNow.viewers}} 人在看</text>
    </view>
    <view class="card live-banner" style="background:{{liveNow.tint}};color:{{liveNow.color}}" hover-class="btn-hover" bindtap="goDetail" data-id="{{liveNow.id}}">
      <view class="live-banner-top">
        <view class="live-dot"></view>
        <text>LIVE · 直播中</text>
      </view>
      <view class="live-banner-title clamp2">{{liveNow.title}}</view>
      <view class="live-banner-meta">{{liveNow.teacher}} · {{liveNow.teacherNote}} · {{liveNow.startText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">即将开播</text>
      <text class="section-more">可预约开播提醒</text>
    </view>
    <view class="card live-list">
      <view class="live-row" wx:for="{{upcomings}}" wx:key="id" hover-class="btn-hover" bindtap="goDetail" data-id="{{item.id}}">
        <view class="live-cover" style="background:{{item.tint}};color:{{item.color}}">
          <text class="live-cover-char">{{item.cover}}</text>
          <text class="live-cover-tag">直播</text>
        </view>
        <view class="live-main">
          <view class="live-title clamp2">{{item.title}}</view>
          <view class="live-meta">{{item.teacher}} · {{item.startText}}</view>
        </view>
        <view class="live-side">
          <text class="tag {{item.reminded ? 'tag-good' : 'tag-warm'}}">{{item.reminded ? '已预约' : '预约'}}</text>
        </view>
      </view>
      <view wx:if="{{!upcomings.length}}" class="empty">近期暂无直播安排</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">精彩回放</text>
    </view>
    <view class="card live-list">
      <view class="live-row" wx:for="{{replays}}" wx:key="id" hover-class="btn-hover" bindtap="goDetail" data-id="{{item.id}}">
        <view class="live-cover" style="background:{{item.tint}};color:{{item.color}}">
          <text class="live-cover-char">{{item.cover}}</text>
          <text class="live-cover-tag">回放</text>
        </view>
        <view class="live-main">
          <view class="live-title clamp2">{{item.title}}</view>
          <view class="live-meta">{{item.teacher}} · {{item.viewers}} 人看过</view>
        </view>
        <view class="live-side"><text class="tag tag-brand">看回放</text></view>
      </view>
      <view wx:if="{{!replays.length}}" class="empty">暂无回放内容</view>
    </view>
  </view>

  <view class="demo-note">演示版本 · 正式版接入微信直播 / 云点播播放与订阅消息推送</view>
</view>
