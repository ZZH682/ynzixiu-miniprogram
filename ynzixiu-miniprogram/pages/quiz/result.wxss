.score { margin: 24rpx 32rpx 48rpx; background: var(--ink); color: #fff; border-radius: 28rpx; padding: 44rpx 40rpx 36rpx; }
.score-title { font-size: 25rpx; color: rgba(255, 255, 255, 0.6); }
.score-num { font-size: 120rpx; font-weight: 800; line-height: 1.1; margin-top: 8rpx; }
.score-unit { font-size: 32rpx; font-weight: 600; margin-left: 8rpx; }
.score-verdict { font-size: 28rpx; margin-top: 4rpx; }
.score-stats { display: flex; margin-top: 36rpx; padding-top: 28rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.12); }
.ss { flex: 1; display: flex; flex-direction: column; }
.ss-v { font-size: 34rpx; font-weight: 700; }
.ss-k { font-size: 22rpx; color: rgba(255, 255, 255, 0.55); margin-top: 2rpx; }

.item { margin-bottom: 16rpx; padding: 28rpx 32rpx; }
.item-head { display: flex; align-items: center; justify-content: space-between; }
.item-head .tag { margin-right: 0; }
.item-no { font-size: 26rpx; font-weight: 700; color: var(--text-3); }
.item-stem { margin-top: 12rpx; font-size: 28rpx; line-height: 1.6; }
.item-detail { margin-top: 16rpx; padding: 20rpx 24rpx; background: var(--bg); border-radius: 14rpx; font-size: 25rpx; color: var(--text-2); line-height: 1.7; }
.item-ana { margin-top: 6rpx; color: var(--text-3); }

.half { flex: 1; }
.half + .half { margin-left: 20rpx; }
