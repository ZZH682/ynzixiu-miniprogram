<view class="stats">
  <view class="stat">
    <text class="stat-num num">{{stats.done}}</text>
    <text class="stat-k">累计做题</text>
  </view>
  <view class="stat">
    <text class="stat-num num">{{stats.rate}}<text class="stat-unit">%</text></text>
    <text class="stat-k">正确率</text>
  </view>
  <view class="stat">
    <text class="stat-num num">{{stats.wrong}}</text>
    <text class="stat-k">错题</text>
  </view>
</view>

<view class="entries">
  <view class="entry entry-mock" hover-class="btn-hover" bindtap="goMock">
    <text class="entry-title">综合模考</text>
    <text class="entry-sub">10 题 · 限时 10 分钟</text>
    <text class="entry-go">开始 →</text>
  </view>
  <view class="entry entry-err" hover-class="btn-hover" bindtap="goErrors">
    <text class="entry-title">错题本</text>
    <text class="entry-sub">{{wrongCount ? wrongCount + ' 道待复习' : '答错的题自动收进来'}}</text>
    <text class="entry-go">查看 →</text>
  </view>
</view>

<view class="section">
  <view class="section-head"><text class="section-title">分科练习</text></view>
  <view class="card subjects">
    <view class="row" wx:for="{{list}}" wx:key="id" hover-class="btn-hover" bindtap="goSubject" data-id="{{item.id}}">
      <view class="mark mark-sm" style="background:{{item.tint}};color:{{item.color}}">{{item.char}}</view>
      <view class="row-main sub-main">
        <view class="sub-name">{{item.name}}</view>
        <view class="sub-meta">{{item.count}} 题<text wx:if="{{item.best > -1}}"> · 最好成绩 {{item.best}} 分</text><text wx:else> · 未练习</text></view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>
</view>
<view class="demo-note">演示题库 · 正式版支持后台批量导入题目</view>
