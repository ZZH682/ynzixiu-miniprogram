.stats { display: flex; margin: 24rpx 32rpx 20rpx; background: var(--ink); border-radius: 24rpx; padding: 36rpx 0; color: #fff; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat + .stat { border-left: 1rpx solid rgba(255, 255, 255, 0.12); }
.stat-num { font-size: 48rpx; font-weight: 700; line-height: 1.2; }
.stat-unit { font-size: 26rpx; margin-left: 2rpx; }
.stat-k { margin-top: 6rpx; font-size: 23rpx; color: rgba(255, 255, 255, 0.6); }

.entries { display: flex; margin: 0 32rpx 48rpx; }
.entry { flex: 1; border-radius: 24rpx; padding: 28rpx; display: flex; flex-direction: column; min-height: 200rpx; }
.entry + .entry { margin-left: 20rpx; }
.entry-mock { background: var(--brand); color: #fff; }
.entry-err { background: var(--card); }
.entry-title { font-size: 32rpx; font-weight: 700; }
.entry-sub { margin-top: 6rpx; font-size: 23rpx; opacity: 0.72; }
.entry-err .entry-sub { color: var(--text-2); opacity: 1; }
.entry-go { margin-top: auto; padding-top: 20rpx; font-size: 24rpx; font-weight: 600; }
.entry-err .entry-go { color: var(--brand); }

.subjects { padding-top: 0; padding-bottom: 0; }
.sub-main { margin-left: 22rpx; }
.sub-name { font-size: 29rpx; font-weight: 500; }
.sub-meta { font-size: 23rpx; color: var(--text-3); margin-top: 2rpx; }
