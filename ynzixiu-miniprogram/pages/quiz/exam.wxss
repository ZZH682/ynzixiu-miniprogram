.top { padding: 24rpx 32rpx 20rpx; }
.top-row { display: flex; align-items: center; justify-content: space-between; }
.top-title { font-size: 28rpx; font-weight: 600; color: var(--text-2); }
.top-count { font-size: 26rpx; color: var(--text-3); }
.timer { font-size: 30rpx; font-weight: 700; color: var(--ink); padding: 4rpx 18rpx; border-radius: 10rpx; background: var(--card); }
.timer.hurry { color: var(--bad); }
.bar { margin-top: 16rpx; height: 8rpx; border-radius: 8rpx; background: var(--line); overflow: hidden; }
.bar-in { height: 100%; background: var(--brand); border-radius: 8rpx; transition: width 0.2s; }

.q { margin: 0 32rpx 20rpx; }
.q-head { display: flex; align-items: center; }
.q-no { font-size: 23rpx; color: var(--text-3); }
.q-stem { margin: 20rpx 0 28rpx; font-size: 33rpx; font-weight: 600; line-height: 1.6; }

.opt { display: flex; align-items: center; padding: 26rpx 24rpx; border-radius: 18rpx; border: 2rpx solid var(--line); margin-bottom: 18rpx; }
.opt-key { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; background: var(--bg); font-size: 24rpx; font-weight: 700; color: var(--text-2); margin-right: 20rpx; flex-shrink: 0; }
.opt-text { font-size: 29rpx; line-height: 1.5; }
.opt.picked { border-color: var(--brand); background: var(--brand-weak); }
.opt.picked .opt-key { background: var(--brand); color: #fff; }
.opt.right { border-color: var(--good); background: var(--good-weak); }
.opt.right .opt-key { background: var(--good); color: #fff; }
.opt.wrong { border-color: var(--bad); background: var(--bad-weak); }
.opt.wrong .opt-key { background: var(--bad); color: #fff; }

.ana { margin-top: 12rpx; border-radius: 18rpx; padding: 24rpx; background: var(--bg); }
.ana-head { font-size: 28rpx; font-weight: 700; }
.ana.ok .ana-head { color: var(--good); }
.ana.no .ana-head { color: var(--bad); }
.ana-text { margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); line-height: 1.7; }
.ana-note { margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); }

.sheet { margin: 0 32rpx; }
.sheet-head { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 600; margin-bottom: 16rpx; }
.sheet-count { font-weight: 400; color: var(--text-3); font-size: 24rpx; }
.dots { display: flex; flex-wrap: wrap; }
.dot { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; border-radius: 50%; border: 2rpx solid var(--line); font-size: 24rpx; color: var(--text-2); margin: 0 18rpx 18rpx 0; }
.dot.done { background: var(--brand-weak); border-color: var(--brand-weak); color: var(--brand); }
.dot.right { background: var(--good-weak); border-color: var(--good-weak); color: var(--good); }
.dot.wrong { background: var(--bad-weak); border-color: var(--bad-weak); color: var(--bad); }
.dot.now { border-color: var(--ink); color: var(--ink); font-weight: 700; }

.nav-btn { width: 220rpx; margin-right: 20rpx; }
.nav-main { flex: 1; }
