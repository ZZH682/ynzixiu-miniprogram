@import "/templates/course.wxss";

.article { background: var(--card); padding: 40rpx 32rpx 48rpx; margin-bottom: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.meta { margin-top: 20rpx; display: flex; align-items: center; font-size: 23rpx; color: var(--text-3); }
.dot { margin: 0 10rpx; }
.body { margin-top: 36rpx; }
.para { font-size: 30rpx; line-height: 1.85; color: var(--ink); margin-bottom: 24rpx; text-align: justify; }
.para:last-child { margin-bottom: 0; }

.cta { border: 2rpx solid var(--brand-weak); }
.cta-title { font-size: 32rpx; font-weight: 600; }
.cta-sub { margin-top: 8rpx; font-size: 25rpx; color: var(--text-2); }
.cta-btn { margin-top: 28rpx; }

.list-card { padding-top: 8rpx; padding-bottom: 8rpx; }
