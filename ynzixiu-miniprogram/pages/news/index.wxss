.sticky { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 20rpx 0 24rpx; }
.list { margin: 0 32rpx; padding-top: 8rpx; padding-bottom: 8rpx; }
.news-row { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); }
.news-row:last-child { border-bottom: none; }
.news-title { font-size: 30rpx; font-weight: 600; line-height: 1.45; }
.news-meta { margin-top: 14rpx; display: flex; align-items: center; font-size: 23rpx; color: var(--text-3); }
.news-views { margin-left: auto; }
