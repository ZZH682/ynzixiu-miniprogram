{
  "description": "云南自修学校小程序演示版（纯前端，本地示例数据）",
  "packOptions": {
    "ignore": [
      {
        "value": "README.md",
        "type": "file"
      },
      {
        "value": "exports",
        "type": "folder"
      }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "checkSiteMap": false,
    "showES6CompileOption": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "ignoreUploadUnusedFiles": true
  },
  "compileType": "miniprogram",
  "libVersion": "3.6.2",
  "projectname": "ynzixiu-miniprogram",
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}