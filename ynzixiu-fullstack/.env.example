# ============================================================
#  云南自修学校 · docker compose 环境变量示例
#  用法： cp .env.example .env，按需修改；docker compose 会自动读取 .env。
#  .env 已被 .gitignore 忽略，请勿把真实密钥提交到仓库。
# ============================================================

# ---- MySQL 8 ----
DB_NAME=ynzixiu
DB_USER=ynzixiu
DB_PASSWORD=ynzixiu
# root 密码（仅 mysql 容器 healthcheck / 管理用）
DB_ROOT_PASSWORD=ynzixiu_root_pwd

# ---- Redis ----
# 留空 = Redis 不设密码；填写后 redis 容器会自动启用 requirepass，
# backend 也会用同一值连接。
REDIS_PASSWORD=

# ---- 数据库初始化（重要）----
# 首次部署设为 always：启动时执行建表（db/mysql/schema.sql）+
# 灌入种子数据（db/mysql/data.sql），启动后即可得到一套可运行的演示数据。
# 初始化完成并确认数据无误后，务必改回 never：schema.sql 内含 DROP TABLE IF EXISTS，
# 长期保持 always 会在每次重启时重建表并清空数据。
DB_INIT_MODE=never

# ---- JWT 密钥（生产必须修改，每个至少 32 字节）----
JWT_USER_SECRET=ynzixiu-user-secret-key-please-change-in-production-2024
JWT_ADMIN_SECRET=ynzixiu-admin-secret-key-please-change-in-production-2024

# ---- Spring / JVM ----
SPRING_PROFILES_ACTIVE=prod
# JVM 参数（堆内存、时区等），按需调整
JAVA_OPTS=-Xms256m -Xmx512m -Duser.timezone=Asia/Shanghai

# ---- 固定说明（无需在 .env 中设置）----
# DB_HOST / REDIS_HOST / DB_PORT / REDIS_PORT 在 compose 编排下由服务名与内网端口
# 固定为 mysql / redis / 3306 / 6379；仅独立运行 jar 时才需要自行指定。
# SERVER_PORT 固定 8600，对外映射 8600:8600。
